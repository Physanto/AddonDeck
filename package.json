{
	"name": "addondeck",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24.11.0"
	},
	"scripts": {
		"dev": "pnpm --recursive --parallel --if-present run dev",
		"build": "pnpm --recursive --if-present run build",
		"test": "vitest run",
		"check": "biome check && pnpm --recursive --if-present run typecheck && depcruise packages apps",
		"format": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^24.19.2",
		"dependency-cruiser": "^18.7.0",
		"tsdown": "^0.23.2",
		"typescript": "6.0.3",
		"vitest": "^5.0.5"
	}
}
