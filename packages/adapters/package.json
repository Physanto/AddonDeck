{
	"name": "@addondeck/adapters",
	"version": "0.0.0",
	"private": true,
	"description": "SDK implementations backed by third-party libraries.",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"@addondeck/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./animator-anime": {
			"@addondeck/source": "./src/animator-anime/index.ts",
			"types": "./dist/animator-anime/index.d.ts",
			"default": "./dist/animator-anime/index.js"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@addondeck/sdk": "workspace:*",
		"animejs": "^4.5.0"
	},
	"devDependencies": {
		"happy-dom": "^20.14.6"
	}
}
