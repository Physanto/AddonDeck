{
	"name": "@addondeck/runtime",
	"version": "0.0.0",
	"private": true,
	"description": "In-browser engine that renders, steps and navigates a deck.",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"@addondeck/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./browser": "./dist/browser.iife.js",
		"./runtime.css": {
			"@addondeck/source": "./src/runtime.css",
			"default": "./dist/runtime.css"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"dev:page": "vite --config dev/vite.config.ts",
		"typecheck": "tsc && tsc -p dev && tsc -p test"
	},
	"dependencies": {
		"@addondeck/core": "workspace:*",
		"@addondeck/sdk": "workspace:*"
	},
	"devDependencies": {
		"happy-dom": "^20.14.6",
		"vite": "^8.3.5"
	}
}
